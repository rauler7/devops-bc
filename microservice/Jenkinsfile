pipeline {
    agent {
        kubernetes {
            yaml '''
                apiVersion: v1
                kind: Pod
                spec:
                  containers:
                  - name: maven
                    image: maven:3.9.6-eclipse-temurin-17
                    command:
                    - cat
                    tty: true
                    volumeMounts:
                    - mountPath: /var/run/docker.sock
                      name: docker-sock
                  volumes:
                  - name: docker-sock
                    hostPath:
                      path: /var/run/docker.sock
            '''
        }
    }
    
    environment {
        VAULT_ADDR = 'http://vault.vault.svc.cluster.local:8200'
        VAULT_USERNAME = credentials('vault-username')
        VAULT_PASSWORD = credentials('vault-password')
        APP_NAME = 'microservice'
        JAVA_HOME = '/opt/java/openjdk'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                container('maven') {
                    dir('microservice') {
                        sh 'mvn clean package'
                    }
                }
            }
        }
        
        stage('Test') {
            steps {
                container('maven') {
                    dir('microservice') {
                        sh 'mvn test'
                    }
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                container('maven') {
                    dir('microservice') {
                        sh 'docker build -t ${APP_NAME}:${BUILD_NUMBER} .'
                    }
                }
            }
        }
        
        stage('Deploy to Development') {
            when {
                branch 'develop'
            }
            steps {
                container('maven') {
                    script {
                        // Login to Vault using userpass
                        sh '''
                            VAULT_TOKEN=$(curl -s --request POST \
                                --data "{\\"password\\": \\"${VAULT_PASSWORD}\\"}" \
                                ${VAULT_ADDR}/v1/auth/userpass/login/${VAULT_USERNAME} | jq -r '.auth.client_token')
                            
                            export VAULT_TOKEN
                        '''
                        
                        withCredentials([vaultSecret(credentialsId: 'kubeconfig-development', path: 'kubeconfig/kv/development/kubeconfig')]) {
                            sh '''
                                echo "$KUBECONFIG" > /tmp/kubeconfig-dev
                                export KUBECONFIG=/tmp/kubeconfig-dev
                                
                                # Deploy using Helm with Vault configuration
                                helm upgrade --install ${APP_NAME} ./helm \
                                    --set image.repository=${APP_NAME} \
                                    --set image.tag=${BUILD_NUMBER} \
                                    --set environment=development \
                                    --set vault.enabled=true \
                                    --set vault.addr=${VAULT_ADDR} \
                                    --set vault.role=${APP_NAME} \
                                    --set vault.path=secret/microservice \
                                    -n development
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                container('maven') {
                    script {
                        // Login to Vault using userpass
                        sh '''
                            VAULT_TOKEN=$(curl -s --request POST \
                                --data "{\\"password\\": \\"${VAULT_PASSWORD}\\"}" \
                                ${VAULT_ADDR}/v1/auth/userpass/login/${VAULT_USERNAME} | jq -r '.auth.client_token')
                            
                            export VAULT_TOKEN
                        '''
                        
                        withCredentials([vaultSecret(credentialsId: 'kubeconfig-deployment', path: 'kubeconfig/kv/deployment/kubeconfig')]) {
                            sh '''
                                echo "$KUBECONFIG" > /tmp/kubeconfig-deploy
                                export KUBECONFIG=/tmp/kubeconfig-deploy
                                
                                # Deploy using Helm with Vault configuration
                                helm upgrade --install ${APP_NAME} ./helm \
                                    --set image.repository=${APP_NAME} \
                                    --set image.tag=${BUILD_NUMBER} \
                                    --set environment=production \
                                    --set vault.enabled=true \
                                    --set vault.addr=${VAULT_ADDR} \
                                    --set vault.role=${APP_NAME} \
                                    --set vault.path=secret/microservice \
                                    -n production
                            '''
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            container('maven') {
                sh 'rm -f /tmp/kubeconfig-*'
                deleteDir()
            }
        }
    }
} 