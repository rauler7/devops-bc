pipeline {
    agent {
        kubernetes {
            yaml '''
                apiVersion: v1
                kind: Pod
                spec:
                  containers:
                  - name: maven
                    image: maven:3.9.6-eclipse-temurin-17
                    command:
                    - cat
                    tty: true
                  - name: docker
                    image: docker:dind
                    securityContext:
                      privileged: true
                    env:
                    - name: DOCKER_TLS_CERTDIR
                      value: ""
                    - name: DOCKER_HOST
                      value: tcp://localhost:2375
                  - name: deploy-tools
                    image: alpine:3.19
                    command:
                    - cat
                    tty: true
                    env:
                    - name: DOCKER_HOST
                      value: tcp://localhost:2375
                    volumeMounts:
                    - mountPath: /var/run/docker.sock
                      name: docker-sock
                  volumes:
                  - name: docker-sock
                    hostPath:
                      path: /var/run/docker.sock
            '''
        }
    }
    
    environment {
        VAULT_ADDR = 'http://vault.vault.svc.cluster.local:8200'
        VAULT_USERNAME = credentials('vault-username')
        VAULT_PASSWORD = credentials('vault-password')
        APP_NAME = 'microservice'
        JAVA_HOME = '/opt/java/openjdk'
        DOCKER_HOST = 'tcp://localhost:2375'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh '''
                    echo "Current branch: $(git rev-parse --abbrev-ref HEAD)"
                    echo "All branches:"
                    git branch -a
                '''
            }
        }
        
        stage('Build') {
            steps {
                container('maven') {
                    dir('microservice') {
                        sh 'mvn clean package'
                    }
                }
            }
        }
        
        stage('Test') {
            steps {
                container('maven') {
                    dir('microservice') {
                        sh 'mvn test'
                    }
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                container('deploy-tools') {
                    dir('microservice') {
                        sh '''
                            # Install Docker CLI
                            apk add --no-cache docker-cli
                            
                            # Wait for Docker daemon to be ready
                            echo "Waiting for Docker daemon..."
                            timeout 30s sh -c 'until docker info; do sleep 1; done'
                            
                            echo "Building Docker image..."
                            docker build -t ${APP_NAME}:${BUILD_NUMBER} .
                            
                            echo "Docker image built successfully"
                            docker images | grep ${APP_NAME}
                        '''
                    }
                }
            }
        }
        
        stage('Deploy to Development') {
            steps {
                container('deploy-tools') {
                    script {
                        try {
                            // First, verify Vault credentials are available
                            echo "Checking Vault credentials..."
                            if (!env.VAULT_USERNAME || !env.VAULT_PASSWORD) {
                                error "Vault credentials are not properly set"
                            }
                            
                            sh '''
                                echo "Installing required tools..."
                                apk add --no-cache curl jq docker-cli helm kubectl
                                
                                echo "Logging into Vault..."
                                VAULT_LOGIN_RESPONSE=$(curl -s --request POST \
                                    --data "{\"password\": \"${VAULT_PASSWORD}\"}" \
                                    ${VAULT_ADDR}/v1/auth/userpass/login/${VAULT_USERNAME})
                                
                                echo "Vault Login Response: ${VAULT_LOGIN_RESPONSE}"
                                
                                VAULT_TOKEN=$(echo "${VAULT_LOGIN_RESPONSE}" | jq -r '.auth.client_token')
                                
                                echo "Extracted VAULT_TOKEN: ${VAULT_TOKEN}"

                                if [ -z "$VAULT_TOKEN" ] || [ "$VAULT_TOKEN" = "null" ]; then
                                    echo "Failed to get Vault token or token is null"
                                    exit 1
                                fi
                                
                                export VAULT_TOKEN
                                echo "Successfully logged into Vault"

                                echo "Retrieving kubeconfig from Vault..."
                                KUBECONFIG_CONTENT_RAW=$(curl -s --header "X-Vault-Token: ${VAULT_TOKEN}" \
                                    ${VAULT_ADDR}/v1/secrets/kubeconfig/kv/development)
                                
                                echo "Kubeconfig Raw Response: ${KUBECONFIG_CONTENT_RAW}"

                                KUBECONFIG_CONTENT=$(echo "${KUBECONFIG_CONTENT_RAW}" | jq -r '.data.data.kubeconfig')

                                echo "Extracted KUBECONFIG_CONTENT: ${KUBECONFIG_CONTENT}"

                                if [ -z "$KUBECONFIG_CONTENT" ] || [ "$KUBECONFIG_CONTENT" = "null" ]; then
                                    echo "Error: Kubeconfig content is empty or null after extraction."
                                    exit 1
                                fi
                                
                                echo "Setting up kubeconfig..."
                                echo "$KUBECONFIG_CONTENT" > /tmp/kubeconfig-dev
                                export KUBECONFIG=/tmp/kubeconfig-dev
                                
                                echo "Verifying kubeconfig file size..."
                                if [ ! -s /tmp/kubeconfig-dev ]; then
                                    echo "Error: kubeconfig file is empty or not created correctly."
                                    exit 1
                                fi
                                
                                echo "Verifying tools installation..."
                                helm version
                                kubectl version --client
                                
                                echo "Deploying to development..."
                                helm upgrade --install ${APP_NAME} ./helm \
                                    --set image.repository=${APP_NAME} \
                                    --set image.tag=${BUILD_NUMBER} \
                                    --set environment=development \
                                    --set vault.enabled=true \
                                    --set vault.addr=${VAULT_ADDR} \
                                    --set vault.role=${APP_NAME} \
                                    --set vault.path=secret/microservice \
                                    -n development
                                
                                echo "Deployment completed successfully"
                            '''
                        } catch (Exception e) {
                            echo "Deployment failed: ${e.message}"
                            echo "Stack trace: ${e.stackTrace}"
                            throw e
                        }
                    }
                }
            }
        }
        
        stage('Deploy to Production') {
            steps {
                container('deploy-tools') {
                    script {
                        try {
                            sh '''
                                echo "Installing required tools..."
                                apk add --no-cache curl jq docker-cli helm kubectl
                                
                                echo "Logging into Vault..."
                                VAULT_TOKEN=$(curl -s --request POST \
                                    --data "{\\"password\\": \\"${VAULT_PASSWORD}\\"}" \
                                    ${VAULT_ADDR}/v1/auth/userpass/login/${VAULT_USERNAME} | jq -r '.auth.client_token')
                                
                                if [ -z "$VAULT_TOKEN" ]; then
                                    echo "Failed to get Vault token"
                                    exit 1
                                fi
                                
                                export VAULT_TOKEN
                                echo "Successfully logged into Vault"
                            '''
                            
                            withCredentials([vaultSecret(credentialsId: 'kubeconfig', path: 'kubeconfig/kv/deployment/kubeconfig')]) {
                                sh '''
                                    echo "Setting up kubeconfig..."
                                    echo "$KUBECONFIG" > /tmp/kubeconfig-deploy
                                    export KUBECONFIG=/tmp/kubeconfig-deploy
                                    
                                    echo "Verifying tools installation..."
                                    helm version
                                    kubectl version --client
                                    
                                    echo "Deploying to production..."
                                    helm upgrade --install ${APP_NAME} ./helm \
                                        --set image.repository=${APP_NAME} \
                                        --set image.tag=${BUILD_NUMBER} \
                                        --set environment=production \
                                        --set vault.enabled=true \
                                        --set vault.addr=${VAULT_ADDR} \
                                        --set vault.role=${APP_NAME} \
                                        --set vault.path=secret/microservice \
                                        -n production
                                    
                                    echo "Deployment completed successfully"
                                '''
                            }
                        } catch (Exception e) {
                            echo "Deployment failed: ${e.message}"
                            throw e
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            container('deploy-tools') {
                sh 'rm -f /tmp/kubeconfig-*'
                deleteDir()
            }
        }
        failure {
            echo "Pipeline failed. Check the logs for details."
        }
    }
} 